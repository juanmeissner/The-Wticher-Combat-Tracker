{
  "name": "the-witcher-combat-tracker",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o tailwind-static.css --minify",
    "build:firebase-auth": "esbuild js/auth/firebase-auth-sdk-entry.js --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=js/auth/firebase-auth.bundle.js",
    "build": "npm run build:css && npm run build:firebase-auth"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
